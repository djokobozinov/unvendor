---
import Base from "../layouts/Base.astro";

const github = "https://github.com/djokobozinov/unvendor";
const codeberg = "https://codeberg.org/gjokob/unvendor";

// Keep in sync with README.md.
const tagline = "An exit toolkit for Backend-as-a-Service platforms, starting with Supabase.";
const summary =
  "Unvendor is an open source toolkit for converting a Backend-as-a-Service deployment into standard, self-hostable components: plain PostgreSQL, any OIDC identity provider and S3-compatible storage. The goal is to do this without a full rewrite of the app.";

const problems = [
  {
    title: "RLS is tied to the platform",
    body: "On Supabase, policies call auth.uid(), auth.jwt() and auth.role(), which only exist in Supabase.",
  },
  {
    title: "Users live in the platform's schema",
    body: "Application tables reference IDs in auth.users, so accounts can't simply be recreated somewhere else.",
  },
  {
    title: "Storage rules are database policies",
    body: "The object store knows nothing about them, so copying files isn't enough.",
  },
];

const mappings = [
  { from: "Supabase Postgres", to: "PostgreSQL", note: "Schema, data and RLS policies" },
  { from: "Supabase Auth", to: "OIDC provider", note: "Keycloak first; Authentik, Zitadel via SCIM 2.0" },
  { from: "Supabase Storage", to: "S3-compatible storage", note: "SeaweedFS, Ceph Object Gateway" },
];

const components = [
  {
    name: "Inventory and source adapter interface",
    body: "Reads schemas, roles, RLS policies that use auth.*, buckets, functions and secrets, and reports everything that has to move. Platform-specific reading sits behind an adapter interface so other platforms can be added later.",
  },
  {
    name: "Auth migration",
    body: "Exports users, identities, password hashes and MFA factors. Imports into Keycloak through its native user import, keeping user IDs and bcrypt hashes through a small Keycloak bcrypt provider, so users don't have to reset their passwords. A SCIM 2.0 export covers other OIDC providers such as Authentik and Zitadel.",
  },
  {
    name: "RLS translation",
    body: "Rewrites policies that call auth.uid(), auth.jwt() and auth.role() into portable SQL on top of a small shim schema. Anything that can't be converted is listed in the report. Every rewrite gets a negative test, and differential tests compare what each user can see on source and target.",
  },
  {
    name: "Storage migration",
    body: "Copies buckets and objects to any S3-compatible backend (SeaweedFS, Ceph Object Gateway), maps public buckets to anonymous read, keeps all other buckets private, and reports per-object rules with their original SQL.",
  },
  {
    name: "Verification and release",
    body: "An end-to-end harness runs the whole migration on a copy and compares row counts, logins and access. Documentation, reproducible packaging on npm, and fixes from a security review.",
  },
];

const later = [
  "Client compatibility shim for supabase-js, so an app keeps running while client code is ported step by step",
  "Edge Functions, Realtime subscriptions and database webhooks",
  "Further source adapters: Firebase, Appwrite and others",
];

const roadmap = [
  "Inventory and source adapter interface",
  "Auth migration → any OIDC provider (Keycloak first; SCIM 2.0 export for others)",
  "RLS translation → plain PostgreSQL with shim schema",
  "Storage migration → S3-compatible storage (SeaweedFS, Ceph Object Gateway)",
  "Verification and release",
];

const h2 = "mb-6 text-[clamp(1.5rem,3vw,2rem)] font-bold";
const section = "mx-auto mt-22 max-w-240 px-4";
---

<Base title="Unvendor: exit toolkit for Backend-as-a-Service platforms" description={`${tagline} ${summary}`}>
  <a
    class="sr-only rounded-lg bg-text px-4 py-2 text-bg focus:not-sr-only focus:absolute focus:top-4 focus:left-4"
    href="#main">Skip to content</a
  >

  <header class="mx-auto flex max-w-240 items-center justify-between gap-4 px-4 pt-6">
    <a class="font-mono text-lg font-bold text-text no-underline" href="/">unvendor</a>
    <nav aria-label="Source repositories">
      <ul class="flex gap-4">
        <li><a class="text-muted no-underline hover:text-text" href={github}>GitHub</a></li>
        <li><a class="text-muted no-underline hover:text-text" href={codeberg}>Codeberg</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <section class="mx-auto mt-18 max-w-240 px-4" aria-labelledby="hero-title">
      <p class="flex items-center gap-2 font-mono text-xs tracking-widest text-muted uppercase">
        <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
        Early development
      </p>
      <h1 id="hero-title" class="my-4 max-w-[24ch] text-[clamp(2rem,5vw,3.25rem)] font-bold">{tagline}</h1>
      <p class="max-w-[60ch] text-xl text-muted">{summary}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="rounded-lg border border-text bg-text px-4.5 py-2.5 font-medium text-bg no-underline hover:opacity-90"
          href={github}>Source on GitHub</a
        >
        <a
          class="rounded-lg border border-border px-4.5 py-2.5 font-medium text-text no-underline hover:border-muted"
          href={codeberg}>Mirror on Codeberg</a
        >
      </div>
    </section>

    <section class={section} aria-labelledby="problem">
      <h2 id="problem" class={h2}>The problem</h2>
      <p class="mb-6 max-w-[70ch]">
        Backend-as-a-Service platforms (Supabase, Firebase, Appwrite, Nhost, PocketBase) bundle database,
        auth, storage and functions behind platform-specific APIs. Apps built on them become hard to
        self-host, migrate or audit, even when parts of the platform are open source.
      </p>
      <div class="mb-6 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
        {
          problems.map((p) => (
            <article class="rounded-xl border border-border bg-surface p-5">
              <h3 class="mb-1.5 text-lg font-semibold">{p.title}</h3>
              <p class="text-muted">{p.body}</p>
            </article>
          ))
        }
      </div>
      <p class="max-w-[70ch] text-muted">
        Today, leaving means a dump, one-off scripts and rewriting access control by hand. Self-hosting
        the platform itself changes where it runs, not what the app depends on.
      </p>
    </section>

    <section class={section} aria-labelledby="how">
      <h2 id="how" class={h2}>How it works</h2>
      <p class="mb-6 max-w-[70ch]">
        Each part of the platform moves onto a standard replacement that can be swapped independently.
        Supabase is the first source platform and the reference implementation; others are planned through
        a source adapter interface.
      </p>
      <ul class="grid gap-4 md:grid-cols-3">
        {
          mappings.map((m) => (
            <li class="flex flex-col rounded-xl border border-border bg-surface p-5 font-mono text-sm">
              <span class="text-muted">{m.from}</span>
              <span class="my-2 text-accent" aria-hidden="true">
                ↓
              </span>
              <span class="sr-only">moves to</span>
              <span class="text-base font-semibold text-accent">{m.to}</span>
              <span class="mt-2 font-sans text-muted">{m.note}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class={section} aria-labelledby="components">
      <h2 id="components" class={h2}>Components</h2>
      <ol class="grid gap-6">
        {
          components.map((c, i) => (
            <li class="flex gap-4">
              <span class="grid size-8 flex-none place-items-center rounded-full bg-accent-soft font-mono text-sm text-accent">
                {i + 1}
              </span>
              <div>
                <h3 class="mb-1.5 flex flex-wrap items-center gap-2 text-lg font-semibold">
                  {c.name}
                  <span class="rounded-full border border-border px-2 py-0.5 font-mono text-xs font-normal text-muted">
                    Planned
                  </span>
                </h3>
                <p class="text-muted">{c.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 max-w-[70ch] text-muted">
        What exists today is a Supabase test fixture: tables with RLS policies, storage buckets with
        per-user folder policies, and a seed script. It is the source project used to develop and test
        the components.
      </p>
      <h3 class="mt-10 mb-2 text-lg font-semibold">After the migration</h3>
      <p class="max-w-[70ch] text-muted">
        Something has to set the claims that the translated policies read. The app's server side, or
        PostgREST, validates the OIDC token and sets them as a transaction-local setting before each
        query; the shim's auth.uid(), auth.jwt() and auth.role() read from that setting. Apps that reach
        the database only through supabase-js need a server-side layer first; the inventory flags this.
      </p>
      <h3 class="mt-10 mb-2 text-lg font-semibold">Later</h3>
      <ul class="max-w-[70ch] list-disc pl-5 text-muted">
        {later.map((l) => <li>{l}</li>)}
      </ul>
    </section>

    <section class={section} aria-labelledby="roadmap">
      <h2 id="roadmap" class={h2}>Roadmap</h2>
      <ol class="border-l-2 border-border">
        {
          roadmap.map((r, i) => (
            <li class="py-2 pl-5">
              <span class="mr-2.5 font-mono text-sm text-muted">M{i + 1}</span>
              {r}
            </li>
          ))
        }
      </ol>
    </section>

    <section class={section} aria-labelledby="open-source">
      <h2 id="open-source" class={h2}>Open source</h2>
      <p class="mb-4 max-w-[70ch]">
        Unvendor is written in TypeScript and licensed under Apache-2.0. It is meant for teams that need to
        run their backend on infrastructure they control: small teams, NGOs, public bodies, and anyone who
        needs data sovereignty, GDPR-compliant self-hosting, or protection against pricing or platform
        changes.
      </p>
      <p class="max-w-[70ch] text-muted">
        If you've moved off a Backend-as-a-Service platform, or tried and gave up,
        <a href={`${github}/issues/new`}>open an issue</a> and describe what broke.
      </p>
    </section>
  </main>

  <footer class="mx-auto mt-22 max-w-240 border-t border-border px-4 pt-6 pb-12 text-muted">
    <p class="mb-1">
      Apache-2.0 · <a href={github}>GitHub</a> · <a href={codeberg}>Codeberg</a>
    </p>
    <p class="text-sm">Unvendor is not affiliated with or endorsed by Supabase or any other platform mentioned here.</p>
  </footer>
</Base>
